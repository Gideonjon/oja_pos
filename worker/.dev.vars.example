# Copy to .dev.vars for local development. Never commit .dev.vars.
PAYSTACK_SECRET_KEY="your_paystack_test_secret_key_here"
VTPASS_API_KEY="xxxxxxxxxxxxxxxxxxxx"
VTPASS_PUBLIC_KEY="PK_xxxxxxxxxxxxxxxx"
VTPASS_SECRET_KEY="SK_xxxxxxxxxxxxxxxx"
# The full service-account JSON on ONE line (Firebase console > Project settings > Service accounts > Generate new private key).
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com"}'
